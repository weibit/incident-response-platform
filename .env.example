# Development-only values. Replace before exposing beyond localhost.
DATABASE_URL=postgresql://incident:incident@localhost:5432/incident
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
JIRA_WEBHOOK_TOKEN=dev-jira-webhook
JIRA_APPROVAL_TOKEN=dev-jira-approval
STATUS_TOKEN=dev-status
SLACK_SIGNING_SECRET=dev-slack-signing
SIEM_SIGNING_SECRET=dev-siem-signing
SLACK_APPROVERS=["U_DEMO_APPROVER"]
ALLOWED_TARGETS=["checkout"]
MOCK_MODE=true
MAX_INVESTIGATION_ROUNDS=6
JOB_TIMEOUT_SECONDS=240
APPROVAL_TTL_SECONDS=3600
# Optional: install a provider package and implement evidence adapters before disabling mock mode.
LLM_MODEL=anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=
# Tracing. Self-hosted only: traces carry unredacted evidence, so LANGFUSE_BASE_URL
# must never point at a host outside the deployment boundary.
# Start the collector with: docker compose --profile observability up
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-dev-public
LANGFUSE_SECRET_KEY=sk-lf-dev-secret
LANGFUSE_BASE_URL=http://langfuse-web:3000
# Judge. Scores completed incidents. Requires tracing, because scores attach to traces.
# One model call per completed incident, so this costs money on a real incident stream.
JUDGE_ENABLED=false
LLM_MODEL_JUDGE=incident-judge

# Runbook knowledge retrieval, served through the gateway. Off by default.
KNOWLEDGE_ENABLED=false
KNOWLEDGE_MCP_URL=http://litellm:4000/mcp/
KNOWLEDGE_MCP_TOKEN=dev-knowledge
KNOWLEDGE_TOP_K=5
# Gateway. Required whenever KNOWLEDGE_ENABLED is true or MOCK_MODE is false.
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=dev-litellm
LITELLM_SALT_KEY=dev-litellm-salt
# Role aliases resolved by the gateway. Each falls back to LLM_MODEL when unset.
LLM_MODEL_TRIAGE=incident-triage
LLM_MODEL_RCA=incident-rca
LLM_MODEL_PLAN=incident-plan
# Context builder: set the window to the smallest model/fallback behind these aliases.
LLM_MODEL_SUMMARY=incident-summary
CONTEXT_WINDOW_TOKENS=32768
CONTEXT_OUTPUT_TOKENS=2048
CONTEXT_SAFETY_TOKENS=2048
CONTEXT_SUMMARY_OUTPUT_TOKENS=768
CONTEXT_SUMMARY_MAX_CALLS=8
CONTEXT_SUMMARY_TIMEOUT_SECONDS=60
# Optional dense retrieval. Lexical search works with no key at all.
# EMBEDDING_MODEL=voyage-3
# EMBEDDING_DIM=1024
# VOYAGE_API_KEY=
