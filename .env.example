# Development-only values. Replace before exposing beyond localhost.
DATABASE_URL=postgresql://incident:incident@localhost:5432/incident
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
JIRA_WEBHOOK_TOKEN=dev-jira-webhook
JIRA_APPROVAL_TOKEN=dev-jira-approval
STATUS_TOKEN=dev-status
SLACK_SIGNING_SECRET=dev-slack-signing
SIEM_SIGNING_SECRET=dev-siem-signing
SLACK_APPROVERS=["U_DEMO_APPROVER"]
ALLOWED_TARGETS=["checkout"]
MOCK_MODE=true
MAX_INVESTIGATION_ROUNDS=6
JOB_TIMEOUT_SECONDS=240
APPROVAL_TTL_SECONDS=3600
# Optional: install a provider package and implement evidence adapters before disabling mock mode.
LLM_MODEL=anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Runbook knowledge retrieval. Off by default; the worker behaves exactly as before.
KNOWLEDGE_ENABLED=false
KNOWLEDGE_MCP_URL=http://runbooks:8080/mcp
KNOWLEDGE_MCP_TOKEN=dev-knowledge
KNOWLEDGE_TOP_K=5
# Optional dense retrieval. Lexical search works with no key at all.
# EMBEDDING_MODEL=voyage-3
# EMBEDDING_DIM=1024
# VOYAGE_API_KEY=
